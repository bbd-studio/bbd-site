---
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const { theme = 'default' } = Astro.props;
const isVision = theme === 'vision';

const links = [
  { href: '/work', label: 'work' },
  { href: '/lab', label: 'lab' },
  { href: '/notebook', label: 'notebook' },
  { href: '/about', label: 'about' },
];
---

<header class={`sticky top-0 z-50 backdrop-blur-xl ${
  isVision ? 'border-b border-white/10 bg-[#050505]/80 text-[#f7f1e8]' : 'border-b border-ink/10 bg-paper/85'
}`}>
  <nav class={`mx-auto px-6 py-4 flex items-center justify-between font-mono text-sm ${
    isVision ? 'max-w-[1440px]' : 'max-w-6xl'
  }`}>
    <a href="/" class={`font-bold tracking-tight transition-colors ${
      isVision ? 'text-[#f7f1e8] hover:text-[#e9a66f]' : 'text-ink hover:text-electric'
    }`}>
      <span class={isVision ? 'text-[#e9a66f]' : 'text-electric'}>{isVision ? '●' : '$'}</span> bbd.sh
    </a>
    <ul class="hidden md:flex items-center gap-6">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class={`transition-colors ${
              isVision
                ? isActive(link.href) ? 'text-[#f7f1e8]' : 'text-[#f7f1e8]/60 hover:text-[#f7f1e8]'
                : isActive(link.href) ? 'text-electric' : 'text-ink/70 hover:text-electric'
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="/contact"
          class={`px-4 py-2 transition-colors rounded-full ${
            isVision
              ? 'border border-white/20 text-[#f7f1e8] hover:bg-[#f7f1e8] hover:text-[#050505]'
              : 'bg-ink text-paper hover:bg-electric hover:text-ink'
          }`}
        >
          start a project →
        </a>
      </li>
    </ul>
    <a
      href="/contact"
      class={`md:hidden text-xs px-3 py-2 rounded-full border ${
        isVision ? 'border-white/20 text-[#f7f1e8]' : 'border-ink/20 text-ink'
      }`}
    >
      start →
    </a>
  </nav>
</header>
