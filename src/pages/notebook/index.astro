---
import Base from '../../layouts/Base.astro';

const entries = [
  {
    slug: 'day-zero',
    title: 'Day 0: starting a public build log',
    excerpt:
      'We\'re publishing the entire process of doing SEO and brand from zero — real numbers, real progress, real reviews.',
    tags: ['kickoff'],
  },
];
---

<Base
  title="Notebook — bbd.sh"
  description="bbd.sh's build log. We document every project as it happens — not marketing copy, just commit history."
>
  <section class="border-b border-ink/10">
    <div class="max-w-3xl mx-auto px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-widest text-muted mb-2">
        ## notebook/
      </p>
      <h1 class="font-display text-5xl md:text-6xl font-bold leading-tight mb-8">
        Build Log
      </h1>
      <p class="text-lg text-ink/70 leading-relaxed">
        We document every project as it happens — not marketing copy, just commit history.
      </p>
    </div>
  </section>

  <section>
    <div class="max-w-3xl mx-auto px-6 py-12">
      <ul class="divide-y divide-ink/10">
        {entries.map((e) => (
          <li class="py-8">
            <a href={`/notebook/${e.slug}`} class="group block">
              <div class="build-meta mb-3">
                {e.tags.map((t) => `#${t}`).join(' ')}
              </div>
              <h2 class="font-display text-3xl font-bold mb-3 group-hover:text-electric transition-colors">
                {e.title}
              </h2>
              <p class="text-ink/70 leading-relaxed">{e.excerpt}</p>
              <p class="mt-3 font-mono text-sm text-electric">read →</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
