---
import Base from '../layouts/Base.astro';
---

<Base
  theme="vision"
  chrome={false}
  title="bbd.sh — Build · Bootstrap · Deliver"
  description="A small builder studio working alongside founders, operators, and investors to validate ideas and ship digital products."
>
  <div id="vision-root" class="relative bg-[#050505]">
    <canvas
      id="vision-canvas"
      class="fixed inset-0 z-0 h-full w-full"
      aria-hidden="true"
    ></canvas>

    <div class="cinema-vignette pointer-events-none fixed inset-0 z-[5]" aria-hidden="true"></div>
    <div class="cinema-grain pointer-events-none fixed inset-0 z-[6]" aria-hidden="true"></div>

    <header class="fixed inset-x-0 top-0 z-20 flex items-center justify-between px-6 py-5 sm:px-10">
      <a href="/" class="cinema-serif text-sm tracking-[0.35em] text-white/70 hover:text-white transition-colors">
        bbd<span class="text-white/40">.sh</span>
      </a>
      <nav class="flex items-center gap-4 sm:gap-8">
        <div class="hidden sm:flex items-center gap-3 text-[10px] uppercase tracking-[0.42em] text-white/40">
          <a href="/work" class="hover:text-white transition-colors">Build</a>
          <span aria-hidden="true">·</span>
          <a href="/lab" class="hover:text-white transition-colors">Bootstrap</a>
          <span aria-hidden="true">·</span>
          <a href="/notebook" class="hover:text-white transition-colors">Deliver</a>
        </div>
        <a
          href="https://citebeam.bbd.sh"
          class="text-[9px] uppercase tracking-[0.3em] text-white/55 hover:text-white transition-colors"
        >
          Citebeam ↗
        </a>
        <a
          href="/contact"
          class="text-[9px] uppercase tracking-[0.35em] text-white/55 hover:text-white transition-colors"
        >
          Contact ↗
        </a>
      </nav>
    </header>

    <main class="relative z-10">
      <section class="relative flex h-screen min-h-[38rem] flex-col items-center justify-center">
        <div data-fade class="flex flex-col items-center text-center">
          <p class="mb-8 text-[10px] uppercase tracking-[0.6em] text-white/45">
            A small builder studio
          </p>
          <h1 class="cinema-serif cinema-hero-title select-none">bbd</h1>
          <p class="cinema-serif mt-10 px-6 text-xl italic tracking-[0.06em] text-white/85 sm:mt-12 sm:text-2xl">
            We build software with founders.
          </p>
          <p class="mt-5 text-[9px] uppercase tracking-[0.46em] text-white/40 sm:text-[10px] sm:tracking-[0.5em]">
            Build · Bootstrap · Deliver
          </p>
        </div>

        <div class="absolute bottom-10 flex flex-col items-center gap-3">
          <span class="text-[9px] uppercase tracking-[0.5em] text-white/35">scroll</span>
          <span class="cinema-scroll-line"></span>
        </div>
      </section>

      <section class="flex h-screen min-h-[38rem] items-center justify-center">
        <div data-fade class="flex flex-col items-center text-center">
          <p class="mb-6 text-[10px] tracking-[0.6em] text-white/40">01 / 03</p>
          <h2 class="cinema-serif cinema-act-title italic">Build</h2>
          <p class="mt-3 text-[10px] uppercase tracking-[0.55em] text-white/50">
            make it tangible
          </p>
          <p class="cinema-serif mt-10 max-w-xl px-6 text-lg leading-relaxed text-white/80 sm:text-xl">
            Turn the idea into something people
            <br class="hidden sm:block" />
            can see, use, and believe in.
          </p>
        </div>
      </section>

      <section class="flex h-screen min-h-[38rem] items-center justify-center">
        <div data-fade class="flex flex-col items-center text-center">
          <p class="mb-6 text-[10px] tracking-[0.6em] text-white/40">02 / 03</p>
          <h2 class="cinema-serif cinema-act-title italic">Bootstrap</h2>
          <p class="mt-3 text-[10px] uppercase tracking-[0.55em] text-white/50">
            find the signal
          </p>
          <p class="cinema-serif mt-10 max-w-xl px-6 text-lg leading-relaxed text-white/80 sm:text-xl">
            Start small enough to learn,
            <br class="hidden sm:block" />
            then follow what proves itself.
          </p>
        </div>
      </section>

      <section class="flex h-screen min-h-[38rem] items-center justify-center">
        <div data-fade class="flex flex-col items-center text-center">
          <p class="mb-6 text-[10px] tracking-[0.6em] text-white/40">03 / 03</p>
          <h2 class="cinema-serif cinema-act-title italic">Deliver</h2>
          <p class="mt-3 text-[10px] uppercase tracking-[0.55em] text-white/50">
            put it in the world
          </p>
          <p class="cinema-serif mt-10 max-w-xl px-6 text-lg leading-relaxed text-white/80 sm:text-xl">
            Ship the real product —
            <br class="hidden sm:block" />
            not another promise of one.
          </p>
        </div>
      </section>

      <section class="flex h-screen min-h-[38rem] items-center justify-center">
        <div data-fade class="flex flex-col items-center text-center">
          <p class="cinema-serif px-6 text-2xl italic leading-relaxed tracking-[0.04em] text-white/90 sm:text-3xl">
            From the first useful signal,
            <br />
            to a product in the world.
          </p>
          <div class="mt-14 h-px w-16 bg-white/25"></div>
          <a
            href="/contact"
            class="mt-10 border border-white/20 rounded-full px-7 py-3 text-[10px] uppercase tracking-[0.42em] text-white/65 hover:bg-white hover:text-black transition-colors"
          >
            Start a project
          </a>
          <div class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-[9px] uppercase tracking-[0.36em] text-white/35">
            <a href="/work" class="hover:text-white transition-colors">Work</a>
            <a href="/lab" class="hover:text-white transition-colors">Lab</a>
            <a href="https://citebeam.bbd.sh" class="hover:text-white transition-colors">Citebeam ↗</a>
            <a href="/about" class="hover:text-white transition-colors">About</a>
          </div>
          <p class="cinema-serif mt-8 text-sm tracking-[0.35em] text-white/60">bbd.sh</p>
        </div>
      </section>
    </main>
  </div>

  <script>
    import { mountVisionCanvas } from '../scripts/vision-canvas';

    const root = document.querySelector<HTMLElement>('#vision-root');
    const canvas = document.querySelector<HTMLCanvasElement>('#vision-canvas');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cleanups: Array<() => void> = [];

    if (canvas) cleanups.push(mountVisionCanvas(canvas));

    if (root && !reduceMotion) {
      const blocks = Array.from(root.querySelectorAll<HTMLElement>('[data-fade]'));
      let frame = 0;
      const update = () => {
        const viewportHeight = window.innerHeight;
        const midpoint = viewportHeight / 2;
        for (const element of blocks) {
          const rect = element.getBoundingClientRect();
          const center = rect.top + rect.height / 2;
          const distance = Math.abs(center - midpoint);
          const opacity = Math.max(0, 1 - distance / (viewportHeight * 0.42));
          element.style.opacity = opacity.toFixed(3);
          element.style.transform = `translateY(${((center - midpoint) * -0.05).toFixed(1)}px)`;
        }
        frame = requestAnimationFrame(update);
      };
      update();
      cleanups.push(() => cancelAnimationFrame(frame));
    }

    window.addEventListener('pagehide', () => {
      for (const cleanup of cleanups) cleanup();
    }, { once: true });
  </script>
</Base>
