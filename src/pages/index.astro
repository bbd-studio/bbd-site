---
import Base from '../layouts/Base.astro';

const labProjects = [
  {
    name: 'starise.io',
    status: 'in-progress',
    statusColor: 'electric',
    description: 'In active development. Details soon.',
    url: 'https://starise.io',
  },
  {
    name: '[more projects]',
    status: 'exploring',
    statusColor: 'muted',
    description: 'New directions in conversation with founders.',
    url: null,
  },
];
---

<Base
  title="bbd.sh — We build software with founders"
  description="A small studio that builds and ships digital products with founders, operators, and investors. We help validate the business, then ship it. Engagement is open — project fee, revenue share, equity, or hybrid."
>
  {/* ════════════════ HERO ════════════════ */}
  <section class="border-b border-ink/10">
    <div class="max-w-6xl mx-auto px-6 py-24 md:py-32">
      <p class="font-mono text-sm text-muted mb-6">
        <span class="text-electric">$</span> ./bbd.sh --about
      </p>
      <p class="font-mono text-xs uppercase tracking-widest text-muted mb-4">
        Build · Bootstrap · Deliver
      </p>

      <h1 class="font-display text-5xl md:text-7xl font-bold leading-[1.05] tracking-tight mb-8">
        We build software<br />
        <span class="italic text-ember">with founders</span>,<br />
        not <span class="text-electric">for them</span><span class="cursor-blink"></span>
      </h1>

      <p class="text-lg md:text-xl text-ink/75 max-w-2xl leading-relaxed mb-10">
        A small studio. We work with founders, operators, and VCs to validate the model and ship the product.<br />
        Engagement is open — project fee, revenue share, equity, or hybrid. What matters is the work ships.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center">
        <a
          href="/contact"
          class="px-6 py-3 bg-ink text-paper hover:bg-electric hover:text-ink transition-colors rounded font-mono text-sm font-bold"
        >
          tell us your idea →
        </a>
        <a
          href="/lab"
          class="px-6 py-3 border border-ink/20 hover:border-electric hover:text-electric transition-colors rounded font-mono text-sm"
        >
          see what we're building ↓
        </a>
      </div>

      <div class="mt-16 pt-8 border-t border-ink/10 grid grid-cols-3 gap-6 max-w-2xl font-mono text-sm">
        <div>
          <p class="text-3xl font-bold text-ink">∞</p>
          <p class="text-xs text-muted mt-1">any digital product</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-ink">⚡</p>
          <p class="text-xs text-muted mt-1">modern AI tooling, used as leverage</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-electric">+1</p>
          <p class="text-xs text-muted mt-1">we build alongside you</p>
        </div>
      </div>
    </div>
  </section>

  {/* ════════════════ MANIFESTO ════════════════ */}
  <section class="border-b border-ink/10">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-widest text-muted mb-2">
        ## manifesto.md
      </p>
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-12 max-w-4xl">
        We <span class="italic text-electric">ship</span> the product.
        We're <span class="italic text-electric">flexible</span> on the deal.
        Founders, operators, and VCs all welcome.
      </h2>

      <div class="grid md:grid-cols-3 gap-8 font-mono text-sm">
        <div class="border border-ink/10 p-6 bg-graphite text-paper">
          <p class="text-electric mb-3">// flexible terms</p>
          <p class="text-paper/80 leading-relaxed">
            Project fee, revenue share,<br />
            equity, or hybrid.<br />
            Pick what fits the situation.
          </p>
        </div>
        <div class="border border-ink/10 p-6 bg-graphite text-paper">
          <p class="text-electric mb-3">// ship over decks</p>
          <p class="text-paper/80 leading-relaxed">
            We don't ship 50-page plans.<br />
            We ship code, designs, and pages<br />
            that take payments — from day one.
          </p>
        </div>
        <div class="border border-ink/10 p-6 bg-graphite text-paper">
          <p class="text-electric mb-3">// partner over vendor</p>
          <p class="text-paper/80 leading-relaxed">
            We don't bill by the hour.<br />
            We're your build partner —<br />
            you decide, we execute.
          </p>
        </div>
      </div>

      <p class="font-display text-3xl md:text-4xl mt-16 max-w-3xl leading-tight">
        We're a <span class="bg-electric text-ink px-2 italic">Builder Studio</span> —
        <br class="hidden md:block" />
        you bring the insight, we bring the code, design, and growth.
      </p>
    </div>
  </section>

  {/* ════════════════ HOW WE WORK ════════════════ */}
  <section class="border-b border-ink/10 bg-ink text-paper">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-widest text-electric mb-2">
        ## workflow.sh
      </p>
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-12">
        From a coffee to live<br />
        <span class="text-electric">how we work with you</span>
      </h2>

      <ol class="space-y-12">
        <li class="grid md:grid-cols-[120px_1fr] gap-6">
          <div class="font-mono text-sm">
            <p class="text-electric font-bold">step 01</p>
          </div>
          <div>
            <h3 class="font-display text-2xl font-bold mb-2">Coffee → Sketch</h3>
            <p class="text-paper/75 leading-relaxed max-w-2xl">
              One conversation to align. We hand back a build sketch —
              product shape, stack, key milestones, path to first revenue.
            </p>
          </div>
        </li>
        <li class="grid md:grid-cols-[120px_1fr] gap-6">
          <div class="font-mono text-sm">
            <p class="text-electric font-bold">step 02</p>
          </div>
          <div>
            <h3 class="font-display text-2xl font-bold mb-2">Probe</h3>
            <p class="text-paper/75 leading-relaxed max-w-2xl">
              We test the smallest signal first — a landing + waitlist,
              a working LLM demo, a recordable prototype.
              The point: <strong class="text-electric">a real signal before either side commits real time</strong>.
            </p>
          </div>
        </li>
        <li class="grid md:grid-cols-[120px_1fr] gap-6">
          <div class="font-mono text-sm">
            <p class="text-electric font-bold">step 03</p>
          </div>
          <div>
            <h3 class="font-display text-2xl font-bold mb-2">Build &amp; Ship</h3>
            <p class="text-paper/75 leading-relaxed max-w-2xl">
              A version that actually runs. Frontend, backend, payments, AI integration,
              brand, copy, and SEO basics — bundled.
              Modern tooling lets us compress the build cycle without cutting quality.
            </p>
          </div>
        </li>
        <li class="grid md:grid-cols-[120px_1fr] gap-6">
          <div class="font-mono text-sm">
            <p class="text-electric font-bold">step 04</p>
            <p class="text-paper/60 text-xs mt-1">your call</p>
          </div>
          <div>
            <h3 class="font-display text-2xl font-bold mb-2">Hand-off or Hold</h3>
            <p class="text-paper/75 leading-relaxed max-w-2xl">
              Once it's live you can take over, hire your own team,
              or keep us on for growth. Entirely your call.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  {/* ════════════════ AI ADVANTAGE ════════════════ */}
  <section class="border-b border-ink/10">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-widest text-muted mb-2">
        ## why_ai.md
      </p>
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-6 max-w-4xl">
        We're not "an AI company."<br />
        We're builders who use <span class="text-ember">AI as leverage</span>.
      </h2>
      <p class="text-lg text-ink/70 max-w-3xl leading-relaxed mb-12">
        Claude / GPT / Cursor / v0 / LangGraph / MCP —
        these tools let a small team take on work that used to need a whole engineering org.
      </p>

      <div class="grid md:grid-cols-2 gap-x-12 gap-y-6 font-mono text-sm">
        {[
          ['Frontend', 'v0 · Cursor · Claude · React/Vue/Svelte · Tailwind'],
          ['Backend', 'GPT-5 + Claude · FastAPI / Hono / Bun · PostgreSQL'],
          ['AI / Agent', 'OpenAI · Anthropic · DeepSeek · LangGraph · MCP'],
          ['Design', 'Figma + AI · Midjourney · in-house brand kit'],
          ['Deploy', 'Cloudflare · Vercel · Fly.io · Edge-first'],
          ['Growth', 'Plausible · PostHog · AEO/GEO monitoring'],
        ].map(([category, tools]) => (
          <div class="border-l-2 border-ink/10 pl-4">
            <p class="text-electric mb-1">{category}</p>
            <p class="text-ink/70">{tools}</p>
          </div>
        ))}
      </div>

      <p class="mt-12 font-display text-2xl italic max-w-3xl text-ink/80">
        "AI doesn't do the work for us — it lets a small team take on big projects."
      </p>
    </div>
  </section>

  {/* ════════════════ CURRENTLY IN LAB ════════════════ */}
  <section class="border-b border-ink/10 bg-paper">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-widest text-muted mb-2">
        ## ./lab/
      </p>
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-4">
        Currently in Lab
      </h2>
      <p class="text-ink/60 mb-12 font-mono text-sm">
        what we're building right now · unfiltered
      </p>

      <div class="space-y-3 font-mono text-sm">
        {labProjects.map((project) => (
          <div class="border border-ink/10 p-5 hover:border-ink/30 transition-colors group">
            <div class="flex items-start justify-between gap-4 mb-2">
              <div class="flex items-center gap-3">
                <span class={`inline-block w-2 h-2 rounded-full ${
                  project.statusColor === 'electric' ? 'bg-electric animate-pulse' :
                  project.statusColor === 'ember' ? 'bg-ember' : 'bg-muted'
                }`}></span>
                <span class="font-bold text-ink text-base">{project.name}</span>
                <span class={`text-xs uppercase tracking-wider ${
                  project.statusColor === 'electric' ? 'text-electric' :
                  project.statusColor === 'ember' ? 'text-ember' : 'text-muted'
                }`}>
                  {project.status}
                </span>
              </div>
            </div>
            <p class="text-ink/70 ml-5">{project.description}</p>
            {project.url && (
              <a href={project.url} target="_blank" class="inline-block mt-2 ml-5 text-electric text-xs hover:underline">
                {project.url} ↗
              </a>
            )}
          </div>
        ))}
      </div>

      <div class="mt-8 pt-6 border-t border-ink/10 font-mono text-xs text-muted">
        <p>※ We're picky about fit. Reach out if your idea matches:</p>
        <ul class="mt-3 space-y-1 list-none">
          <li><span class="text-electric">[ ]</span> you'll be hands-on (not handing it off)</li>
          <li><span class="text-electric">[ ]</span> you can name the customer and the pain</li>
          <li><span class="text-electric">[ ]</span> the project stays inside legal lines</li>
        </ul>
        <a href="/contact" class="inline-block mt-6 text-ink hover:text-electric font-bold">
          → send us your idea
        </a>
      </div>
    </div>
  </section>

  {/* ════════════════ NOTEBOOK PREVIEW ════════════════ */}
  <section class="border-b border-ink/10">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-widest text-muted mb-2">
        ## notebook/
      </p>
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-4">
        Build Log
      </h2>
      <p class="text-ink/60 mb-12 max-w-2xl">
        We document every project as it happens — not marketing copy, just commit history.
      </p>

      <div class="space-y-8">
        <article class="grid md:grid-cols-[150px_1fr] gap-6 group cursor-pointer">
          <div class="build-meta">
            <span class="text-electric">day 0</span>
          </div>
          <div>
            <h3 class="font-display text-2xl font-bold mb-2 group-hover:text-electric transition-colors">
              <a href="/notebook/day-zero">Day 0: starting a public build log</a>
            </h3>
            <p class="text-ink/70 leading-relaxed">
              We're publishing the entire process of doing SEO and brand from zero —
              real numbers, real progress, real reviews.
            </p>
          </div>
        </article>
      </div>

      <a href="/notebook" class="inline-block mt-12 font-mono text-sm text-ink hover:text-electric">
        all entries →
      </a>
    </div>
  </section>

  {/* ════════════════ FINAL CTA ════════════════ */}
  <section class="bg-ink text-paper">
    <div class="max-w-6xl mx-auto px-6 py-32 text-center">
      <p class="font-mono text-xs uppercase tracking-widest text-electric mb-6">
        # ready_to_ship
      </p>
      <h2 class="font-display text-4xl md:text-6xl font-bold leading-tight mb-8">
        Idea you've been sitting on?<br />
        <span class="italic text-electric">This time, ship it.</span>
      </h2>
      <a
        href="/contact"
        class="inline-block px-8 py-4 bg-electric text-ink hover:bg-paper transition-colors rounded font-mono text-base font-bold"
      >
        $ ./let-us-talk →
      </a>
      <p class="mt-6 font-mono text-xs text-paper/50">
        hello@bbd.sh
      </p>
    </div>
  </section>
</Base>
