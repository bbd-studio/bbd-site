---
import Base from '../layouts/Base.astro';

const projects = [
  {
    name: 'Citebeam',
    tagline: 'Know what AI is saying about your brand',
    status: 'live',
    statusColor: 'electric',
    description:
      'Citebeam monitors how brands appear across Chinese AI assistants, connected search, Bilibili, and Douyin — then lets brand teams interrogate the evidence in plain language.',
    techStack: '—',
    url: 'https://citebeam.bbd.sh',
  },
  {
    name: 'Starise',
    tagline: 'The launchpad to tomorrow’s markets',
    status: 'in-progress',
    statusColor: 'electric',
    description:
      'Starise is the launchpad to tomorrow’s markets. We back visionary founders building AI, clean energy, and fintech companies across Africa, Asia, and Latin America. Backed by Transsion.',
    techStack: '—',
    url: 'https://www.starise.io',
  },
  {
    name: '[more projects]',
    tagline: 'In exploration',
    status: 'exploring',
    statusColor: 'muted',
    description: 'New directions in conversation with founders. We\'ll publish them when ready.',
    techStack: '—',
    url: null,
  },
];
---

<Base
  title="Currently in Lab — bbd.sh"
  description="Live status of every project bbd.sh is incubating. We build in public — unfiltered, no spin."
>
  <section class="border-b border-ink/10">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-widest text-muted mb-2">
        ## ./lab/ --list
      </p>
      <h1 class="font-display text-5xl md:text-6xl font-bold leading-tight mb-6">
        Currently in Lab
      </h1>
      <p class="text-lg text-ink/70 max-w-2xl leading-relaxed mb-2">
        Live status of every project we're incubating — unfiltered, no spin.
        Updated as it changes.
      </p>
    </div>
  </section>

  <section class="border-b border-ink/10">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <div class="space-y-6">
        {projects.map((p) => (
          <article class="border border-ink/10 hover:border-ink/30 transition-colors">
            <div class="p-8">
              <div class="flex items-start justify-between gap-4 mb-4 font-mono text-sm">
                <div class="flex items-center gap-3">
                  <span class={`inline-block w-2 h-2 rounded-full ${
                    p.statusColor === 'electric' ? 'bg-electric animate-pulse' :
                    p.statusColor === 'ember' ? 'bg-ember' : 'bg-muted'
                  }`}></span>
                  <span class="font-bold text-ink text-lg">{p.name}</span>
                  <span class={`text-xs uppercase tracking-wider ${
                    p.statusColor === 'electric' ? 'text-electric' :
                    p.statusColor === 'ember' ? 'text-ember' : 'text-muted'
                  }`}>
                    {p.status}
                  </span>
                </div>
              </div>

              <p class="font-display text-2xl font-bold mb-3">{p.tagline}</p>
              <p class="text-ink/70 leading-relaxed mb-4 max-w-3xl">
                {p.description}
              </p>

              {p.url && (
                <div class="font-mono text-xs text-muted mt-4 pt-4 border-t border-ink/10">
                  <a href={p.url} target="_blank" class="text-ink hover:text-electric">
                    {p.name} → {p.url} ↗
                  </a>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-ink/10 bg-graphite text-paper">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <h2 class="font-display text-3xl font-bold mb-6">Want to be the next lab project?</h2>
      <p class="text-paper/75 leading-relaxed max-w-2xl mb-8">
        We're picky about fit. Tell us your idea and we'll get back fast.
      </p>
      <a
        href="/contact"
        class="inline-block px-6 py-3 bg-electric text-ink hover:bg-paper transition-colors rounded font-mono font-bold text-sm"
      >
        send us your idea →
      </a>
    </div>
  </section>
</Base>
